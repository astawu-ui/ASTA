@echo off
setlocal EnableExtensions
title 牛来了 . 股市桌宠  安装程序
cd /d "%~dp0"
set "CFGDIR=%APPDATA%\NiuLaiPet"
set "WHEREFILE=%CFGDIR%\install_dir.txt"
set "DEFDIR=%LOCALAPPDATA%\NiuLaiPet"
set "LOG=%TEMP%\niupet_install.txt"
set "TMPF=%TEMP%\niupet_py.txt"
set "ZIP=%TEMP%\niupet_pkg.zip"
set "B64=%TEMP%\niupet_pkg.b64"
set "PICKF=%TEMP%\niupet_pick.txt"
set "ALIVE=%TEMP%\niupet_alive.txt"
set "PYURL=https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe"
set "PYSETUP=%TEMP%\python-3.12.10-amd64.exe"

rem 上次装到哪了（换位置重装时要把老地方清掉）
set "OLDDIR="
if exist "%WHEREFILE%" set /p OLDDIR=<"%WHEREFILE%"
if defined OLDDIR if not exist "%OLDDIR%\main.py" set "OLDDIR="
if not defined OLDDIR if exist "%DEFDIR%\main.py" set "OLDDIR=%DEFDIR%"
set "INSTALL=%DEFDIR%"
if defined OLDDIR set "INSTALL=%OLDDIR%"

echo === 牛来了桌宠 安装日志 ===> "%LOG%"
echo 时间: %DATE% %TIME% >> "%LOG%"
echo 安装包: %~f0 >> "%LOG%"
echo 系统: %OS% %PROCESSOR_ARCHITECTURE% >> "%LOG%"
echo 上次装在: %OLDDIR% >> "%LOG%"

cls
echo.
echo    ==============================================================
echo        牛来了 . 股市桌宠      安 装 程 序
echo    ==============================================================
echo.
echo    一头毛绒小牛住在你的桌面上：自己走路、跑步、爬窗口边、
echo    吊在窗口下沿；还能盯着你选的股票 —— 涨就笑，跌就垮。
echo.
echo    版本：      2.7.0  （2026-08-26）
echo    快捷方式：  桌面 + 开始菜单
echo    第一次安装需要联网下载运行环境，大约 80MB，之后不再下载。
echo    不需要管理员权限，不改系统设置，附带一键卸载。
echo    如果机器上已经装过旧版，会先自动关掉并清理干净再装新的。
echo.
set "GO="
set /p "GO=   按回车开始安装，输入 N 回车退出: "
if /i "%GO%"=="N" goto CANCEL

rem ============================================================ 0 安装位置
:ASK_WHERE
echo.
echo    [0/6] 装到哪里？
echo.
echo       1  默认位置（推荐）： %INSTALL%
echo       2  浏览…  弹一个文件夹选择框，鼠标点就行
echo       3  自己敲一个路径
echo.
echo       不管选哪个，最后都会落在一层 NiuLaiPet 文件夹里 ——
echo       这样卸载时只删自己的东西，不会动你目录里的别的文件。
echo.
set "PICK="
set /p "PICK=   请选择（直接回车 = 1）: "
if not defined PICK goto WHERE_OK
if "%PICK%"=="1" goto WHERE_OK
if "%PICK%"=="2" goto PICK_BROWSE
if "%PICK%"=="3" goto PICK_TYPE
echo    只认 1 / 2 / 3，再选一次。
goto ASK_WHERE

:PICK_BROWSE
if exist "%PICKF%" del /q "%PICKF%" >nul 2>&1
echo    正在弹出选择框…（如果没看见，去任务栏找一下）
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=New-Object -ComObject Shell.Application;$f=$s.BrowseForFolder(0,'选择「牛来了桌宠」装在哪个文件夹里',81,17);if($f -and $f.Self -and $f.Self.Path){[IO.File]::WriteAllText('%PICKF%',$f.Self.Path,[Text.Encoding]::Default)};exit 0" >nul 2>&1
set "WHERE="
if exist "%PICKF%" set /p WHERE=<"%PICKF%"
if exist "%PICKF%" del /q "%PICKF%" >nul 2>&1
if not defined WHERE goto WHERE_CANCEL
goto WHERE_NORM

:WHERE_CANCEL
echo.
echo    没选（或者选择框没弹出来），回上一步重来。
goto ASK_WHERE

:PICK_TYPE
echo.
echo       比如  D:\Tools  或者  E:\软件\桌宠 ，中文和空格都行。
set "WHERE="
set /p "WHERE=   路径: "
if not defined WHERE goto ASK_WHERE

:WHERE_NORM
rem 去掉粘贴时常带的引号和结尾的反斜杠
set "WHERE=%WHERE:"=%"
if not defined WHERE goto ASK_WHERE
if "%WHERE:~-1%"=="\" set "WHERE=%WHERE:~0,-1%"
if not defined WHERE goto ASK_WHERE

rem 末级目录不叫 NiuLaiPet 就补一层，绝不直接往用户给的目录里铺文件
for %%D in ("%WHERE%") do set "LEAF=%%~nxD"
if /i not "%LEAF%"=="NiuLaiPet" set "WHERE=%WHERE%\NiuLaiPet"

rem 路径太长会踩 Windows 260 字符上限，装完 import 会失败，先拦住
if not "%WHERE:~150%"=="" goto WHERE_LONG

rem 真建出来写个文件试试，不能写就换一个
mkdir "%WHERE%" >nul 2>&1
copy nul "%WHERE%\.wtest" >nul 2>&1
if not exist "%WHERE%\.wtest" goto WHERE_BAD
del /q "%WHERE%\.wtest" >nul 2>&1
set "INSTALL=%WHERE%"
goto WHERE_OK

:WHERE_LONG
echo.
echo    [x] 这个路径太长了（Windows 完整路径上限 260 字符，装完会起不来）。
echo        换一个短一点的，比如 D:\NiuLaiPet
goto ASK_WHERE

:WHERE_BAD
echo.
echo    [x] 这个位置建不了文件夹、或者没有写入权限：
echo        %WHERE%
echo        换一个位置试试（别用 C:\Program Files 这种要管理员权限的地方）。
goto ASK_WHERE

:WHERE_OK
echo          将安装到： %INSTALL%
echo 安装目录: %INSTALL% >> "%LOG%"

rem ============================================================ 1 找 Python
echo.
echo    [1/6] 正在检查 Python 运行环境...
set "PYEXE="
call :TRYPY "py -3"
if defined PYEXE goto GOT_PY
call :TRYPY "python"
if defined PYEXE goto GOT_PY
call :SCAN "%LocalAppData%\Programs\Python"
if defined PYEXE goto GOT_PY
call :SCAN "%ProgramFiles%"
if defined PYEXE goto GOT_PY
call :SCAN "%ProgramFiles(x86)%"
if defined PYEXE goto GOT_PY
call :SCAN "C:\"
if defined PYEXE goto GOT_PY
goto NEED_PY

:GOT_PY
echo          Python: %PYEXE%
echo 使用 Python: %PYEXE% >> "%LOG%"
for %%F in ("%PYEXE%") do set "PYDIR=%%~dpF"
set "PYW=%PYDIR%pythonw.exe"
if not exist "%PYW%" set "PYW=%PYEXE%"

rem ============================================================ 2 清理旧版本
echo.
echo    [2/6] 正在清理旧版本...
set "OLDVER="
if exist "%INSTALL%\version.txt" set /p OLDVER=<"%INSTALL%\version.txt"
if defined OLDVER echo          发现已安装版本：%OLDVER%
if defined OLDVER echo 旧版本: %OLDVER% >> "%LOG%"

rem 2a 先请正在运行的桌宠自己退出（新版认这个信号，会保存位置后收摊）
echo niupet-upgrade> "%TEMP%\niupet_quit.flag"
ping -n 3 127.0.0.1 >nul

rem 2b 还没退的直接结束进程（只挑命令行里带 NiuLaiPet 的，绝不动别的 Python 程序）
powershell -NoProfile -ExecutionPolicy Bypass -Command "$n=0;try{$ps=Get-CimInstance Win32_Process -ErrorAction Stop}catch{$ps=Get-WmiObject Win32_Process};foreach($p in $ps){if(($p.Name -match 'python') -and $p.CommandLine -and ($p.CommandLine -match 'NiuLaiPet|niupet')){try{Stop-Process -Id $p.ProcessId -Force -ErrorAction Stop;$n++}catch{}}};foreach($p in (Get-Process -Name 'NiuLaiPet' -ErrorAction SilentlyContinue)){try{Stop-Process -Id $p.Id -Force;$n++}catch{}};Write-Host ('killed=' + $n);exit 0" >>"%LOG%" 2>&1
if exist "%TEMP%\niupet_quit.flag" del /q "%TEMP%\niupet_quit.flag" >nul 2>&1
if exist "%ALIVE%" del /q "%ALIVE%" >nul 2>&1
echo          已关闭正在运行的旧桌宠

rem 2c 记住旧的开机自启设置，稍后指向新路径
set "HADAUTO="
reg query "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v NiuLaiPet >nul 2>&1
if not errorlevel 1 set "HADAUTO=1"
reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v NiuLaiPet /f >nul 2>&1

rem 2d 删掉旧快捷方式（含早期版本用的中文名）
powershell -NoProfile -ExecutionPolicy Bypass -Command "foreach($d in @([Environment]::GetFolderPath('Desktop'),[Environment]::GetFolderPath('Programs'))){foreach($n in @('NiuLaiPet.lnk','牛来了桌宠.lnk','牛来了桌宠 - 快捷方式.lnk')){Remove-Item (Join-Path $d $n) -Force -ErrorAction SilentlyContinue}};exit 0" >>"%LOG%" 2>&1

rem 2e 换了安装位置的话，把老地方整个搬走 —— 三重确认是自己的目录才敢删
if not defined OLDDIR goto CLEAN_HERE
if /i "%OLDDIR%"=="%INSTALL%" goto CLEAN_HERE
if not exist "%OLDDIR%\main.py" goto CLEAN_HERE
if not exist "%OLDDIR%\niupet\character.py" goto CLEAN_HERE
for %%D in ("%OLDDIR%") do set "OLDLEAF=%%~nxD"
if /i not "%OLDLEAF%"=="NiuLaiPet" goto CLEAN_HERE
echo          换了安装位置，正在删掉老的那份：%OLDDIR%
echo 删除旧位置: %OLDDIR% >> "%LOG%"
rmdir /s /q "%OLDDIR%" >nul 2>&1

:CLEAN_HERE
rem 清掉旧程序文件（保留 dist/build 里自己打的 exe，也保留配置）
if not exist "%INSTALL%" goto CLEAN_DONE
rmdir /s /q "%INSTALL%\niupet" >nul 2>&1
rmdir /s /q "%INSTALL%\tools" >nul 2>&1
rmdir /s /q "%INSTALL%\assets" >nul 2>&1
rmdir /s /q "%INSTALL%\__pycache__" >nul 2>&1
del /q "%INSTALL%\*.py" >nul 2>&1
del /q "%INSTALL%\*.bat" >nul 2>&1
del /q "%INSTALL%\*.cmd" >nul 2>&1
del /q "%INSTALL%\*.md" >nul 2>&1
del /q "%INSTALL%\*.txt" >nul 2>&1
echo          旧程序文件已清理

:CLEAN_DONE

rem ============================================================ 3 释放文件
echo.
echo    [3/6] 正在释放程序文件...
if exist "%ZIP%" del /q "%ZIP%" >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';try{$sb=New-Object System.Text.StringBuilder;foreach($l in [IO.File]::ReadLines('%~f0',[Text.Encoding]::ASCII)){if($l.StartsWith('::B64::')){[void]$sb.Append($l.Substring(7))}};if($sb.Length -lt 1000){throw '没找到内嵌的程序数据'};[IO.File]::WriteAllBytes('%ZIP%',[Convert]::FromBase64String($sb.ToString()));Add-Type -AssemblyName System.IO.Compression.FileSystem;$dst='%INSTALL%';if(-not (Test-Path -LiteralPath $dst)){New-Item -ItemType Directory -Path $dst -Force | Out-Null};$z=[IO.Compression.ZipFile]::OpenRead('%ZIP%');foreach($e in $z.Entries){$p=Join-Path $dst $e.FullName;$d=Split-Path $p -Parent;if(-not (Test-Path -LiteralPath $d)){New-Item -ItemType Directory -Path $d -Force | Out-Null};if($e.Name -ne ''){[IO.Compression.ZipFileExtensions]::ExtractToFile($e,$p,$true)}};$z.Dispose();exit 0}catch{Write-Host $_;exit 1}" >>"%LOG%" 2>&1
if exist "%INSTALL%\niupet\character.py" goto UNPACK_OK
echo          PowerShell 方式没成功，改用 certutil + tar 兜底...
if exist "%B64%" del /q "%B64%" >nul 2>&1
setlocal EnableDelayedExpansion
> "%B64%" (
  for /f "usebackq delims=" %%L in (`findstr /b "::B64::" "%~f0"`) do (
    set "X=%%L"
    echo(!X:~7!
  )
)
endlocal
certutil -decode "%B64%" "%ZIP%" >>"%LOG%" 2>&1
if not exist "%INSTALL%" mkdir "%INSTALL%" >nul 2>&1
where tar.exe >nul 2>&1
if errorlevel 1 goto UNPACK_FAIL
tar -xf "%ZIP%" -C "%INSTALL%" >>"%LOG%" 2>&1
if not exist "%INSTALL%\niupet\character.py" goto UNPACK_FAIL

:UNPACK_OK
if not exist "%INSTALL%\main.py" goto UNPACK_FAIL
if exist "%INSTALL%\niupet\__pycache__" rmdir /s /q "%INSTALL%\niupet\__pycache__" >nul 2>&1
echo          程序文件已就位

rem ============================================================ 4 装 PySide6
echo.
echo    [4/6] 正在准备界面库 PySide6...
"%PYEXE%" -c "import PySide6" >nul 2>&1
if not errorlevel 1 goto DEPS_OK
echo          第一次要下载约 80MB，通常 1-5 分钟，请不要关窗口...
"%PYEXE%" -m pip install --upgrade pip 2>>"%LOG%"
"%PYEXE%" -m pip install PySide6 2>>"%LOG%"
"%PYEXE%" -c "import PySide6" >nul 2>&1
if not errorlevel 1 goto DEPS_OK
echo          官方源不通，换清华镜像...
"%PYEXE%" -m pip install PySide6 -i https://pypi.tuna.tsinghua.edu.cn/simple 2>>"%LOG%"
"%PYEXE%" -c "import PySide6" >nul 2>&1
if not errorlevel 1 goto DEPS_OK
echo          再换阿里云镜像...
"%PYEXE%" -m pip install --user PySide6 -i https://mirrors.aliyun.com/pypi/simple 2>>"%LOG%"
"%PYEXE%" -c "import PySide6" >nul 2>&1
if not errorlevel 1 goto DEPS_OK
goto DEPS_FAIL

:DEPS_OK
echo          界面库就绪

rem ============================================================ 5 快捷方式
echo.
echo    [5/6] 正在创建快捷方式...
set "ICONARG=%INSTALL%\assets\niu.ico"
if not exist "%ICONARG%" set "ICONARG=%PYW%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "try{$w=New-Object -ComObject WScript.Shell;foreach($f in @([Environment]::GetFolderPath('Desktop'),[Environment]::GetFolderPath('Programs'))){$s=$w.CreateShortcut($f+'\NiuLaiPet.lnk');$s.TargetPath='%PYW%';$s.Arguments='\"%INSTALL%\main.py\"';$s.WorkingDirectory='%INSTALL%';$s.IconLocation='%ICONARG%';$s.Description='NiuLai Pet - 股市桌宠';$s.Save()};exit 0}catch{Write-Host $_;exit 1}" >>"%LOG%" 2>&1
echo          桌面和开始菜单都放好了（名字：NiuLaiPet）
> "%INSTALL%\version.txt" echo 2.7.0
rem 记住这次装在哪，下次装新版才知道去哪儿清老的
if not exist "%CFGDIR%" mkdir "%CFGDIR%" >nul 2>&1
> "%WHEREFILE%" echo %INSTALL%
if not defined HADAUTO goto NO_AUTO
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v NiuLaiPet /t REG_SZ /d "\"%PYW%\" \"%INSTALL%\main.py\"" /f >nul 2>&1
echo          原来开着开机自启，已重新指向新版本
:NO_AUTO

rem ============================================================ 6 启动
echo.
echo    [6/6] 正在启动桌宠...
cd /d "%INSTALL%"
"%PYEXE%" -c "from PySide6.QtWidgets import QApplication;a=QApplication([]);import niupet.pet" >>"%LOG%" 2>&1
if errorlevel 1 goto RUN_VISIBLE
if exist "%ALIVE%" del /q "%ALIVE%" >nul 2>&1
start "" "%PYW%" "%INSTALL%\main.py"
ping -n 9 127.0.0.1 >nul
if exist "%ALIVE%" goto DONE
ping -n 6 127.0.0.1 >nul
if exist "%ALIVE%" goto DONE
goto RUN_VISIBLE

:DONE
cls
echo.
echo    ==============================================================
echo        安装完成！桌宠已经在屏幕上跑起来了   （版本 2.7.0）
echo    ==============================================================
echo.
echo    用法：
echo      . 左键拖动它；松手时按落点决定姿势 ——
echo        窗口顶边中段 = 坐着晃腿，两端 = 站着，侧沿 = 贴墙爬，下沿 = 吊着
echo      . 双击它 = 摸摸头
echo      . 右键它 = 互动 / 行为模式 / 股市联动 / 设置 / 退出
echo      . 滚轮 = 放大缩小
echo      . 右下角托盘牛头 = 看状态、隐藏、退出
echo        Win11 图标常被折叠：点任务栏 ^^ 箭头，把牛头拖到任务栏上
echo.
echo    股市联动：右键 - 股市联动 - 跟踪大盘指数 / 我的自选 / 搜索添加自选股
echo      涨 = 眯眼笑或星星眼，跌 = 掉眼泪或大哭。行情仅供参考。
echo      股票、ETF、指数、可转债、国债逆回购都能搜。
echo.
echo    安装位置： %INSTALL%
echo    以后启动： 双击桌面的 NiuLaiPet 图标
echo    卸载：     打开 %INSTALL% ，双击 卸载.bat
echo    说明书：   %INSTALL%\使用说明.md
echo.
pause
exit /b 0

:RUN_VISIBLE
echo.
echo    程序装好了，但启动检测没通过。用可见方式再跑一次，把错误显示出来：
echo    ------------------------------------------------------------
"%PYEXE%" "%INSTALL%\main.py"
echo    ------------------------------------------------------------
echo    如果桌宠出来了就是正常的，关掉本窗口即可。
echo    如果有报错，请把 %LOG% 发给我。
echo.
pause
exit /b 1

:NEED_PY
echo          没有可用的 Python。
echo.
echo    桌宠需要 Python 运行环境（python.org 官方安装包，约 30MB，
echo    只装到当前用户，不需要管理员权限，不影响其它软件）。
echo.
set "A="
set /p "A=   现在自动下载安装吗？按回车继续，输入 N 退出: "
if /i "%A%"=="N" goto MANUAL
echo.
echo    正在下载 Python 3.12.10 ...
if exist "%PYSETUP%" del /q "%PYSETUP%" >nul 2>&1
where curl.exe >nul 2>&1
if errorlevel 1 goto DL_PS
curl -L --retry 2 -o "%PYSETUP%" "%PYURL%" 2>>"%LOG%"
if exist "%PYSETUP%" goto DL_OK
:DL_PS
echo    换 PowerShell 下载...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue';try{Invoke-WebRequest -Uri '%PYURL%' -OutFile '%PYSETUP%' -UseBasicParsing}catch{exit 1}" >>"%LOG%" 2>&1
if exist "%PYSETUP%" goto DL_OK
goto DL_FAIL

:DL_OK
echo    正在静默安装 Python（1-2 分钟，请稍等）...
"%PYSETUP%" /quiet InstallAllUsers=0 PrependPath=1 Include_pip=1 Include_launcher=1 Include_test=0 AssociateFiles=0 Shortcuts=0 >>"%LOG%" 2>&1
set "PYEXE="
call :SCAN "%LocalAppData%\Programs\Python"
if defined PYEXE goto GOT_PY
call :TRYPY "py -3"
if defined PYEXE goto GOT_PY
call :SCAN "%ProgramFiles%"
if defined PYEXE goto GOT_PY
goto INSTALL_FAIL

rem ============================================================ 出错分支
:UNPACK_FAIL
echo.
echo    [x] 释放程序文件失败。
echo        可能原因：安全软件把 PowerShell 和 certutil 都拦了，
echo                  或者安装包在传输过程中被截断/改动过。
echo        详情见 %LOG%
echo        变通办法：把这个 bat 改名成 .txt 传输，对方改回 .bat 再运行。
echo.
pause
exit /b 1

:DEPS_FAIL
echo.
echo    [x] PySide6 安装失败。详情见 %LOG%
echo        手动执行： "%PYEXE%" -m pip install PySide6
echo        公司网络有代理的，先设好代理再试。
echo.
pause
exit /b 1

:DL_FAIL
echo.
echo    [x] Python 下载失败（网络或代理限制）。
goto MANUAL

:INSTALL_FAIL
echo.
echo    [x] Python 装好了但没找到，重启电脑后再运行一次本安装包即可。
goto MANUAL

:MANUAL
echo.
echo    手动装 Python 的办法：
echo      1) 打开 https://www.python.org/downloads/windows/
echo      2) 下载 Windows installer (64-bit)
echo      3) 安装第一屏一定勾上 Add python.exe to PATH
echo      4) 装完重新双击本安装包
echo.
pause
exit /b 1

:CANCEL
echo.
echo    已取消，什么都没改动。
echo.
ping -n 3 127.0.0.1 >nul
exit /b 0

rem ============================================================ 子程序
:TRYPY
%~1 -c "import sys;raise SystemExit(0 if sys.version_info>=(3,9) and sys.maxsize>2**32 else 1)" >nul 2>&1
if errorlevel 1 goto :eof
%~1 -c "import sys;print(sys.executable)" > "%TMPF%" 2>>"%LOG%"
if errorlevel 1 goto :eof
set /p PYEXE=<"%TMPF%"
if not exist "%PYEXE%" set "PYEXE="
goto :eof

:SCAN
if not exist "%~1" goto :eof
for /d %%D in ("%~1\Python3*") do if exist "%%~fD\python.exe" call :TRYEXE "%%~fD\python.exe"
goto :eof

:TRYEXE
if defined PYEXE goto :eof
"%~1" -c "import sys;raise SystemExit(0 if sys.version_info>=(3,9) and sys.maxsize>2**32 else 1)" >nul 2>&1
if errorlevel 1 goto :eof
set "PYEXE=%~1"
goto :eof

